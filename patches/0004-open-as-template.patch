diff --git a/glabels/File.cpp b/glabels/File.cpp
--- a/glabels/File.cpp
+++ b/glabels/File.cpp
@@ -143,0 +144,46 @@
+
+        ///
+        /// Open File As Template
+        ///
+        void File::openAsTemplate( MainWindow *window )
+        {
+                QString cwd = mCwd;
+                if ( window->model() && !window->model()->fileName().isEmpty() )
+                {
+                        QFileInfo fileInfo( window->model()->fileName() );
+                        if ( fileInfo.isFile() )
+                        {
+                                cwd = fileInfo.absolutePath();
+                        }
+                }
+
+                QString fileName =
+                        QFileDialog::getOpenFileName( window,
+                                                      tr("gLabels - Open As Template"),
+                                                      cwd,
+                                                      tr("glabels files (*.glabels);;All files (*)")
+                                );
+
+                if ( !fileName.isEmpty() )
+                {
+                        model::Model *model = model::XmlLabelParser::readFile( fileName );
+                        if ( model )
+                        {
+                                model->setFileName( QString() );
+                                model->setModified();
+
+                                if ( window->isEmpty() )
+                                {
+                                        window->setModel( model );
+                                }
+                                else
+                                {
+                                        auto *newWindow = new MainWindow();
+                                        newWindow->setModel( model );
+                                        newWindow->show();
+                                }
+
+                                mCwd = QFileInfo( fileName ).absolutePath();
+                        }
+                }
+        }
+

